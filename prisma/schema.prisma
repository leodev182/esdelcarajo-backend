// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MEN
  WOMEN
  KIDS
}

enum Size {
  S
  M
  L
  XL
  XXL
  XXXL
}

enum OrderStatus {
  PENDING_PAYMENT
  PAGO_CONFIRMADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  ANULADA
}

enum PaymentMethod {
  TRANSFERENCIA
  PAGO_MOVIL
  ZELLE
  EFECTIVO
  MERCADO_PAGO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  nickname  String?
  avatar    String?
  googleId  String   @unique
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses      Address[]
  cart           Cart?
  orders         Order[]       @relation("OrderUser")
  handledOrders  Order[]       @relation("OrderHandledBy")
  favorites      Favorite[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([googleId])
  @@index([nickname])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Address {
  id     String @id @default(uuid())
  userId String
  alias  String

  fullName String
  phone    String

  state        String
  city         String
  municipality String?
  address      String
  zipCode      String?
  reference    String?

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  color       String
  icon        String?
  order       Int     @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@index([slug])
  @@index([isActive])
  @@index([order])
}

model Subcategory {
  id          String  @id @default(uuid())
  categoryId  String
  name        String
  slug        String
  description String? @db.Text
  icon        String?
  order       Int     @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String @db.Text
  longDescription String? @db.Text

  categoryId    String
  subcategoryId String?

  metaTitle       String?
  metaDescription String?

  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  favorites   Favorite[]
  tags        ProductTag[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductVariant {
  id        String @id @default(uuid())
  productId String

  gender   Gender
  size     Size
  color     String
  colorHex  String?
  shirtColor String?

  sku   String  @unique
  stock Int     @default(0)
  price Decimal @db.Decimal(10, 2)

  shortDescription String? @db.Text
  features         String? @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  images     ProductImageVariant[]

  @@unique([productId, gender, size, color])
  @@index([productId])
  @@index([sku])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  publicId  String
  alt       String
  order     Int     @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductImageVariant[]

  @@index([productId])
  @@index([order])
}

model ProductImageVariant {
  id        String @id @default(uuid())
  imageId   String
  variantId String

  image   ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([imageId, variantId])
  @@index([imageId])
  @@index([variantId])
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@index([expiresAt])
}

model Order {
  id        String @id @default(uuid())
  userId    String
  addressId String

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING_PAYMENT)

  paymentMethod PaymentMethod
  paymentProof  String?

  customerNotes    String? @db.Text
  adminNotes       String? @db.Text
  handledByAdminId String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User        @relation("OrderUser", fields: [userId], references: [id])
  address        Address     @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  handledByAdmin User?       @relation("OrderHandledBy", fields: [handledByAdminId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([handledByAdminId])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  variantId String

  productName   String
  variantSize   Size
  variantColor  String
  variantGender Gender
  price         Decimal @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Favorite {
  id        String @id @default(uuid())
  userId    String
  productId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  slug  String  @unique
  color String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([slug])
}

model ProductTag {
  id        String @id @default(uuid())
  productId String
  tagId     String

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

enum Currency {
  EUR
  USD
  VES
}

model ExchangeRate {
  id String @id @default(uuid())

  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal  @db.Decimal(15, 8)
  valueDate    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, valueDate])
  @@index([valueDate])
  @@index([fromCurrency, toCurrency])
}

enum SectionType {
  CAROUSEL
  CUSTOM
  VIDEO
}

enum TextPosition {
  LEFT
  CENTER
  RIGHT
  TOP
  BOTTOM
}

model LandingSection {
  id           String       @id @default(uuid())
  type         SectionType
  title        String
  description  String?      @db.Text
  textPosition TextPosition @default(CENTER)
  bgColor      String       @default("#FFFFFF")
  videoUrl     String?
  order        Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  images SectionImage[]

  @@index([type])
  @@index([isActive])
  @@index([order])
}

model SectionImage {
  id        String @id @default(uuid())
  sectionId String
  url       String
  publicId  String
  alt       String @default("")
  order     Int    @default(0)

  section LandingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([order])
}

// ─────────────────────────────────────────────
// Logs del sistema
// ─────────────────────────────────────────────

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum LogEvent {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  USER_REGISTERED
  // Usuarios
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED
  // Órdenes
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  ORDER_CANCELLED
  ORDER_PAYMENT_CONFIRMED
  // Productos
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  // Sistema
  UNHANDLED_EXCEPTION
  CUSTOM_EVENT
}

model Log {
  id           String    @id @default(uuid())
  level        LogLevel
  event        LogEvent
  message      String    @db.Text

  // Contexto HTTP (opcional — llenado por AllExceptionsFilter)
  method       String?
  url          String?
  statusCode   Int?

  // Actor
  userId       String?
  userEmail    String?

  // Error (solo el mensaje, sin stackTrace — eso va a archivos)
  errorMessage String?   @db.Text

  // Contexto corto del servicio/evento: "OrdersService.create | orderId:abc"
  context      String?

  // Ciclo de vida
  isPermanent  Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  // Índices para queries reales
  @@index([createdAt])
  @@index([level, createdAt])
  @@index([isPermanent, expiresAt])
  @@index([userId])
}